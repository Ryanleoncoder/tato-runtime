{
  "manifest_version": 3,
  "key": "",
  "name": "Tato",
  "version": "0.1.0",
  "description": "Deixa um agente operar apenas as abas que esta extensão abrir.",
  "minimum_chrome_version": "116",
  "permissions": [
    "alarms",
    "debugger",
    "tabGroups",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Conectar o Tato",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icones/tato-16.png",
      "32": "icones/tato-32.png"
    }
  },
  "icons": {
    "16": "icones/tato-16.png",
    "32": "icones/tato-32.png",
    "48": "icones/tato-48.png",
    "128": "icones/tato-128.png"
  }
}
